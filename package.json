{
  "name": "esable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "setup"
  ],
  "scripts": {
    "dev:frontend": "vite frontend",
    "dev:backend": "npx tsx setup/index.ts",
    "dev:mockbackend": "npx tsx setup/mock_infrasetup_server.ts",
    "build": "tsc -b frontend && vite build frontend",
    "lint": "eslint frontend",
    "preview": "vite preview frontend",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "test:setup": "vitest --config setup/vitest.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@splinetool/r3f-spline": "^1.0.2",
    "leva": "^0.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
